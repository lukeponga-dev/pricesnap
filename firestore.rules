rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if document belongs to user
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Scans collection: User can only read/write their own scans
    match /scans/{scanId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false; // Scans are immutable history records
    }

    // Users collection: User can only read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
