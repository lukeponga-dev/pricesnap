# Set one real server-side key. Never prefix a secret with VITE_.
GEMINI_API_KEY=""
# Optional alias (takes precedence when non-empty):
GOOGLE_AI_STUDIO_API_KEY=""

# Override these if your Google project uses a different supported model.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_GROUNDING_MODEL="gemini-3.8-flash"

# No marketplace API credentials or guessed exchange rates are used.
# Gemini Google Search grounding remains subject to Google's quota and pricing.
PORT=3000
