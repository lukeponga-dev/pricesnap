# Gemini Vision identification
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_AI_STUDIO_API_KEY="MY_GOOGLE_AI_STUDIO_API_KEY"

# Google Programmable Search / compatible Custom Search JSON API.
# Configure the search engine to cover the public web or the marketplace domains you need.
GOOGLE_SEARCH_API_KEY="MY_GOOGLE_SEARCH_API_KEY"
GOOGLE_SEARCH_CX="MY_PROGRAMMABLE_SEARCH_ENGINE_ID"

# eBay Browse API grounding
EBAY_CLIENT_ID="MY_EBAY_CLIENT_ID"
EBAY_CLIENT_SECRET="MY_EBAY_CLIENT_SECRET"

# Currency conversion to NZD. PriceSnap refuses unsupported currencies rather than guessing rates.
AUD_NZD_RATE="1.10"
USD_NZD_RATE="1.65"

# APP_URL: deployed application URL.
APP_URL="MY_APP_URL"
